# 豆包（火山引擎方舟）配置。只有用「豆包大模型」分词引擎时才需要填。
# 用法：把本文件复制成 backend/.env，填上自己的 key。不填也能用本地 jieba 引擎。
# key 在火山引擎控制台开通豆包大模型后获取：https://console.volcengine.com/ark

# API Key（必填，留空则豆包引擎显示为不可用）
ARK_API_KEY=

# 模型 ID，也可以填推理接入点 ep-xxxxxxxx
ARK_MODEL=doubao-seed-1-6-250615

# OpenAI 兼容端点，一般不用改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 单次请求超时（秒），超时会自动回退到 jieba
ARK_TIMEOUT=12
