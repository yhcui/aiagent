<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="top"
        android:height="2dp">
        <shape>
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#00A78BFA"
                android:centerColor="#B3A78BFA"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
    <item android:top="2dp">
        <shape>
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <solid android:color="#EE121630" />
        </shape>
    </item>
</layer-list>
