<!--测试详情页 · 奏折-->
<view class="detail-page" wx:if="{{!loading && test}}">

  <!-- 封面英雄 -->
  <view class="cover">
    <view class="cover-glow a"></view>
    <view class="cover-glow b"></view>
    <view class="cover-inner a-bloom">
      <text class="cover-emblem">🏮</text>
      <view class="cover-title song">{{test.title}}</view>
      <view class="cover-share">{{test.share_title}}</view>
    </view>
  </view>

  <!-- 奏折说明 -->
  <view class="paper a-rise" style="animation-delay: 0.08s;">
    <view class="paper-edge"></view>
    <view class="card-head">
      <view class="head-emblem">📜</view>
      <view class="head-title">测 试 说 明</view>
    </view>
    <view class="paper-body">{{test.description || '暂无说明'}}</view>
  </view>

  <!-- 卷册信息 -->
  <view class="paper a-rise" style="animation-delay: 0.18s;">
    <view class="paper-edge"></view>
    <view class="paper-row">
      <view class="row-label">题目数量</view>
      <view class="row-value">{{test.question_count}} 题</view>
    </view>
    <view class="gold-rule"></view>
    <view class="paper-row">
      <view class="row-label">预估时长</view>
      <view class="row-value">约 {{test.question_count * 0.5}} 分钟</view>
    </view>
    <view class="gold-rule"></view>
    <view class="paper-row">
      <view class="row-label">命格试金</view>
      <view class="row-value price" wx:if="{{test.price > 0}}">¥{{test.priceYuan}}</view>
      <view class="row-value free" wx:else>免费</view>
    </view>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部 CTA -->
  <view class="cta-bar safe-bottom">
    <view class="btn-main" bindtap="startTest">
      {{test.price > 0 ? '✨ 开始测算 ¥' + test.priceYuan : '✨ 开始测算'}}
    </view>
  </view>
</view>

<!-- 加载骨架 -->
<view class="loading-page" wx:if="{{loading}}">
  <view class="skeleton-block" style="height: 480rpx;"></view>
  <view class="skeleton-block" style="height: 260rpx; margin-top: 24rpx;"></view>
  <view class="loading-tip">宫人正在铺纸研墨…</view>
</view>