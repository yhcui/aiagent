/* 答题页 · 入宫答题 */

.quiz-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF8F3 340rpx);
}

/* ── 宫灯进度 ── */
.quiz-head {
  padding: 30rpx 32rpx 0;
}

.lantern-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.lantern {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lantern-cap {
  width: 14rpx;
  height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #D8CBD1;
}

.lantern-core {
  width: 44rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #F4EAED;
  transition: background 0.3s ease, box-shadow 0.3s ease;
}

/* 已点亮的灯 */
.lantern.lit .lantern-cap {
  background: var(--c-gold);
}

.lantern.lit .lantern-core {
  background: linear-gradient(180deg, #FF9DBB 0%, #FF6B9D 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 157, 0.4);
}

/* 当前题目的灯（呼吸） */
.lantern.now .lantern-core {
  animation: breath 1.6s ease-in-out infinite;
}

@keyframes breath {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.14); }
}

/* 丝绸进度 */
.ribbon-track {
  margin-top: 26rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F3E4E9;
  overflow: hidden;
}

.ribbon-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FF9DBB 0%, #FF6B9D 55%, #FF8E53 100%);
  transition: width 0.35s cubic-bezier(0.22, 0.9, 0.35, 1);
}

.head-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hm-left {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--c-ink);
}

.hm-right {
  font-size: 24rpx;
  color: var(--c-mist);
  letter-spacing: 2rpx;
}

/* ── 题舞台 ── */
.q-stage {
  flex: 1;
  padding: 34rpx 32rpx;
  transition: opacity 0.16s ease, transform 0.16s ease;
}

.q-stage.phase-out {
  opacity: 0;
  transform: translateX(-36rpx);
  pointer-events: none;
}

.q-stage.phase-in {
  animation: qIn 0.3s cubic-bezier(0.22, 0.9, 0.35, 1) both;
}

@keyframes qIn {
  from { opacity: 0; transform: translateX(44rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* 题卡（卷轴+印章） */
.q-card {
  position: relative;
  background: #fff;
  border-radius: var(--r-card);
  padding: 44rpx 36rpx;
  box-shadow: var(--sh-card);
  display: flex;
  align-items: flex-start;
}

.q-card-edge {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(90deg, rgba(255, 107, 157, 0) 0%, rgba(255, 107, 157, 0.75) 50%, rgba(255, 107, 157, 0) 100%);
}

.q-seal {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #E35D82 0%, #C9486B 100%);
  box-shadow: 0 8rpx 16rpx rgba(201, 72, 107, 0.32);
}

.q-text {
  margin-left: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.7;
  color: var(--c-ink);
}

/* ── 选项 ── */
.option-list {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--r-card);
  border: 2rpx solid #F0E3E8;
  padding: 28rpx 30rpx;
  transition: all 0.16s ease;
}

.option:active {
  transform: scale(0.98);
}

.option-hover {
  transform: scale(0.98);
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.option.selected {
  border-color: var(--c-rouge);
  background: linear-gradient(135deg, #FFF3F6 0%, #FFE9EF 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 157, 0.18);
}

.opt-seal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-song);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-ash);
  background: #F7EFF2;
  border: 2rpx solid #EDDFE4;
  transition: all 0.16s ease;
}

.option.selected .opt-seal {
  color: #fff;
  background: linear-gradient(135deg, #FF8EB3 0%, #FF6B9D 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 12rpx rgba(255, 107, 157, 0.35);
}

.opt-text {
  flex: 1;
  margin-left: 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--c-ink);
}

.option.selected .opt-text {
  color: var(--c-rouge-deep);
  font-weight: 600;
}

.opt-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  background: var(--c-jade);
  box-shadow: 0 4rpx 10rpx rgba(76, 169, 140, 0.4);
}

/* ── 底部导航 ── */
.nav-bar {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 32rpx 30rpx;
  gap: 24rpx;
  background: linear-gradient(180deg, rgba(255, 248, 243, 0) 0%, #FFF8F3 40%);
}

.nav-prev {
  flex-shrink: 0;
  padding: 24rpx 34rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #F0E3E8;
  font-size: 28rpx;
  color: var(--c-ash);
}

.nav-prev:active {
  transform: scale(0.96);
}

.nav-next {
  flex: 1;
}

/* 加载骨架 */
.quiz-loading {
  padding: 32rpx;
}

/* 加载失败 */
.err-lantern {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.retry-load {
  width: 320rpx;
  height: 88rpx;
  font-size: 28rpx;
  margin-top: 30rpx;
}