<!--测试列表页 · 宫闱测算-->
<view class="list-page">

  <!-- 页首 -->
  <view class="page-head a-rise">
    <view class="ph-title song">宫闱测算</view>
    <view class="ph-sub">选一题入宫 · 测出你的命格</view>
    <view class="gold-rule"></view>
  </view>

  <!-- 测题列表 -->
  <view class="test-list" wx:if="{{!loading && testList.length > 0}}">
    <view
      class="test-card a-rise"
      style="animation-delay: {{index * 0.08}}s;"
      wx:for="{{testList}}"
      wx:key="id"
      bindtap="goTestDetail"
      data-id="{{item.id}}"
    >
      <view class="tc-cover {{index % 2 === 0 ? 'hue-pink' : 'hue-gold'}}">
        <view class="tc-glow"></view>
        <view class="tc-glow glow-tl"></view>
        <text class="tc-emblem">{{index % 2 === 0 ? '🏮' : '📜'}}</text>
        <view class="tc-flag">宫 廷 命 格</view>
      </view>
      <view class="tc-body">
        <view class="tc-title song">{{item.title}}</view>
        <view class="tc-desc">{{item.description}}</view>
        <view class="tc-meta">
          <view class="jade-tag">{{item.question_count}} 题 · 约 4 分钟</view>
          <view class="tc-price" wx:if="{{item.price > 0}}">¥{{item.priceYuan}}</view>
          <view class="tc-price free" wx:else>免费</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 骨架 -->
  <view class="sk-list" wx:if="{{loading}}">
    <view class="skeleton-block" style="height: 320rpx;"></view>
    <view class="skeleton-block" style="height: 200rpx; margin-top: 24rpx;"></view>
    <view class="skeleton-block" style="height: 120rpx; margin-top: 24rpx;"></view>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:if="{{!loading && testList.length === 0}}">
    <image src="/images/empty.png" mode="aspectFit"></image>
    <view class="empty-title">宫人们正在筹备测算</view>
    <view class="empty-hint">下拉刷新试试</view>
  </view>

  <view class="safe-bottom"></view>
</view>