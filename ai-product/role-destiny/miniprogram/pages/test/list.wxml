<!--测试列表页-->
<view class="list-page">
  <view class="list-container">
    <view class="test-grid" wx:if="{{!loading && testList.length > 0}}">
      <view
        class="test-item"
        wx:for="{{testList}}"
        wx:key="id"
        bindtap="goTestDetail"
        data-id="{{item.id}}"
      >
        <view class="test-cover">
          <image
            src="{{item.cover_image || '/images/default_cover.png'}}"
            mode="aspectFill"
          ></image>
          <view class="test-price-tag" wx:if="{{item.price > 0}}">
            ¥{{item.priceYuan}}
          </view>
          <view class="test-price-tag free" wx:else>免费</view>
        </view>
        <view class="test-info">
          <text class="test-title">{{item.title}}</text>
          <text class="test-desc">{{item.description}}</text>
          <view class="test-stats">
            <text class="stat-item">{{item.question_count || 0}}题</text>
          </view>
        </view>
      </view>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="empty-state" wx:if="{{!loading && testList.length === 0}}">
      <image src="/images/empty.png" mode="aspectFit"></image>
      <text>暂无测试</text>
    </view>
  </view>
</view>
