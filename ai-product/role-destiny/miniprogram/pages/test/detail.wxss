/* 测试详情页 · 奏折 */

.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF8F3 420rpx);
}

/* 封面英雄 */
.cover {
  position: relative;
  height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: linear-gradient(160deg, #FFD9E4 0%, #FFC4D3 58%, #F5B7C8 100%);
}

.cover-glow {
  position: absolute;
  border-radius: 50%;
}

.cover-glow.a {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: -240rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 70%);
}

.cover-glow.b {
  width: 420rpx;
  height: 420rpx;
  left: -180rpx;
  bottom: -200rpx;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.28) 0%, rgba(255, 107, 157, 0) 72%);
}

.cover-inner {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.cover-emblem {
  font-size: 120rpx;
  filter: drop-shadow(0 12rpx 20rpx rgba(150, 60, 90, 0.28));
}

.cover-title {
  margin-top: 26rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--c-ink);
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.6);
}

.cover-share {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(59, 47, 54, 0.6);
}

/* 奏折纸卡 */
.paper {
  position: relative;
  margin: 0 32rpx 28rpx;
  background: #fff;
  border-radius: var(--r-card);
  padding: 36rpx 32rpx 32rpx;
  box-shadow: var(--sh-card);
}

/* 奏折金边 */
.paper-edge {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(90deg, rgba(201, 162, 75, 0) 0%, rgba(201, 162, 75, 0.8) 50%, rgba(201, 162, 75, 0) 100%);
}

.paper-body {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--c-ash);
}

.paper-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
}

.paper .gold-rule {
  margin: 0 0;
  opacity: 0.6;
}

.row-label {
  font-size: 27rpx;
  color: var(--c-ash);
}

.row-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-ink);
}

.row-value.price {
  font-family: var(--font-song);
  font-size: 32rpx;
  color: var(--c-rouge);
}

.row-value.free {
  color: var(--c-jade);
}

/* 底部 CTA */
.bottom-space {
  height: 180rpx;
}

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx 28rpx;
  background: linear-gradient(180deg, rgba(255, 248, 243, 0) 0%, rgba(255, 248, 243, 0.96) 30%, #FFF8F3 100%);
}

/* 加载骨架 */
.loading-page {
  padding: 32rpx;
}

.loading-tip {
  margin-top: 40rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--c-mist);
}