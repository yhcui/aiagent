/* 首页 · 命格宫殿 */

.home {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFEFF2 0%, #FFF8F3 46%, #FFF8F3 100%);
}

/* ── 英雄区 ── */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx 48rpx;
  overflow: hidden;
}

/* 云雾（CSS 圆团） */
.deco {
  position: absolute;
  pointer-events: none;
}

.cloud-a {
  width: 420rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  filter: blur(10rpx);
  top: 150rpx;
  left: -160rpx;
}

.cloud-b {
  width: 480rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  filter: blur(12rpx);
  top: 420rpx;
  right: -200rpx;
}

.petal-a {
  top: 260rpx;
  left: 56rpx;
  font-size: 34rpx;
  opacity: 0.85;
}

.petal-b {
  top: 400rpx;
  right: 64rpx;
  font-size: 26rpx;
  opacity: 0.7;
}

/* 品牌 */
.brand {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-seal {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: radial-gradient(circle at 35% 30%, #F6E3B4 0%, #D9B463 55%, #C9A24B 100%);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(201, 162, 75, 0.35);
}

.brand-name {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  color: var(--c-ink);
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--c-ash);
}

/* 月门 */
.gate {
  position: relative;
  z-index: 1;
  width: 560rpx;
  height: 560rpx;
  margin-top: 40rpx;
}

.gate-halo {
  position: absolute;
  inset: -30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 157, 184, 0.28) 0%, rgba(255, 157, 184, 0) 70%);
}

.gate-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 42%),
    radial-gradient(circle at 50% 55%, #FFF3F6 0%, #FFDEE8 78%);
  border: 6rpx solid rgba(201, 162, 75, 0.65);
  box-shadow:
    inset 0 0 0 16rpx rgba(255, 255, 255, 0.75),
    inset 0 0 60rpx rgba(255, 107, 157, 0.22),
    0 24rpx 60rpx rgba(255, 107, 157, 0.28);
}

.gate-spark {
  position: absolute;
  z-index: 3;
  color: var(--c-gold);
  font-size: 26rpx;
}

.gate-spark.s1 { top: 16rpx; right: 96rpx; }
.gate-spark.s2 { bottom: 90rpx; left: 60rpx; font-size: 20rpx; }

/* 门内徽记 */
.gate-emblem {
  position: absolute;
  z-index: 2;
}

.gate-emblem.p0 { left: 50%; top: 64rpx; transform: translateX(-50%); }
.gate-emblem.p1 { left: 78rpx; bottom: 88rpx; }
.gate-emblem.p2 { right: 78rpx; bottom: 88rpx; }

.gem-circle {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 12rpx 24rpx rgba(63, 47, 54, 0.16);
}

.gem-emoji {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.12));
}

/* CTA */
.cta {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 600rpx;
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cta .btn-main {
  width: 100%;
}

.cta-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--c-mist);
}

/* 播报条 */
.ticker {
  position: relative;
  z-index: 2;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 158, 189, 0.35);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 157, 0.12);
  backdrop-filter: blur(8rpx);
}

.ticker-mark {
  color: var(--c-gold);
  font-size: 24rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.ticker-text {
  font-size: 24rpx;
  color: var(--c-ash);
  letter-spacing: 1rpx;
}

/* ── 本期限定 ── */
.section {
  position: relative;
  padding: 8rpx 32rpx 32rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--c-ink);
}

.section-link {
  font-size: 24rpx;
  color: var(--c-mist);
}

.section .gold-rule {
  margin-bottom: 28rpx;
}

.feature-card {
  background: #fff;
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--sh-card);
  margin-bottom: 28rpx;
  transition: transform 0.15s ease;
}

.feature-card:active {
  transform: scale(0.98);
}

.fc-cover {
  position: relative;
  height: 300rpx;
  background: linear-gradient(135deg, #FFE1E8 0%, #FFC9D8 60%, #F7B9C9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.fc-glow {
  position: absolute;
  border-radius: 50%;
}

.glow-a {
  width: 380rpx;
  height: 380rpx;
  right: -120rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0) 68%);
}

.glow-b {
  width: 300rpx;
  height: 300rpx;
  left: -100rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(255, 107, 157, 0.24) 0%, rgba(255, 107, 157, 0) 70%);
}

.fc-emblem {
  position: relative;
  font-size: 110rpx;
  filter: drop-shadow(0 10rpx 16rpx rgba(150, 60, 90, 0.25));
}

.fc-lantern {
  position: absolute;
  top: 36rpx;
  right: 40rpx;
  color: #fff;
  font-size: 26rpx;
  opacity: 0.9;
}

.fc-flag {
  position: absolute;
  left: 0;
  top: 40rpx;
  padding: 8rpx 26rpx 8rpx 22rpx;
  background: linear-gradient(135deg, #C9A24B, #D9B463);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  box-shadow: 0 6rpx 14rpx rgba(201, 162, 75, 0.4);
}

.fc-body {
  padding: 30rpx 32rpx 32rpx;
}

.fc-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--c-ink);
}

.fc-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--c-ash);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fc-meta {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fc-price {
  font-family: var(--font-song);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-rouge);
}