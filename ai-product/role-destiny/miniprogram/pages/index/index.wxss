/* 首页样式 */

.index-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF 100%);
}

/* 头部区域 */
.header {
  position: relative;
  height: 400rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  z-index: 1;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: white;
  border-radius: 30rpx;
  padding: 15rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.3);
}

.logo image {
  width: 100%;
  height: 100%;
}

.app-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 4rpx;
}

.app-subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 测试区域 */
.test-section {
  padding: 30rpx;
  margin-top: -60rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* 测试卡片 */
.test-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.test-card {
  display: flex;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.3s ease;
}

.test-card:active {
  transform: scale(0.98);
}

.test-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.test-cover image {
  width: 100%;
  height: 100%;
}

.test-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  margin-left: 20rpx;
  padding: 8rpx 0;
}

.test-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.test-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 10rpx;
}

.test-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.test-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B6B;
}

.test-price.free {
  color: #52C41A;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  color: #999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #ccc;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}
