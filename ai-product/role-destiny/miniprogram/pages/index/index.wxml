<!--首页 - 启动页面-->
<view class="index-page">
  <!-- 顶部装饰 -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="logo">
        <image src="/images/logo.png" mode="aspectFit"></image>
      </view>
      <text class="app-title">角色测算</text>
      <text class="app-subtitle">发现你的性格原型</text>
    </view>
  </view>

  <!-- 测试列表 -->
  <view class="test-section">
    <view class="section-header">
      <text class="section-title">热门测试</text>
      <text class="section-more" bindtap="goTestList">更多 ></text>
    </view>

    <view class="test-list" wx:if="{{!loading && testList.length > 0}}">
      <view
        class="test-card"
        wx:for="{{testList}}"
        wx:key="id"
        bindtap="goTest"
        data-id="{{item.id}}"
      >
        <view class="test-cover">
          <image
            src="{{item.cover_image || '/images/default_cover.png'}}"
            mode="aspectFill"
          ></image>
        </view>
        <view class="test-info">
          <text class="test-title">{{item.title}}</text>
          <text class="test-desc">{{item.description}}</text>
          <view class="test-meta">
            <text class="test-price" wx:if="{{item.price > 0}}">¥{{item.priceYuan}}</text>
            <text class="test-price free" wx:else>免费</text>
          </view>
        </view>
      </view>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>

    <view class="empty-state" wx:if="{{!loading && testList.length === 0}}">
      <image src="/images/empty.png" mode="aspectFit"></image>
      <text>暂无测试</text>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-area-bottom"></view>
</view>
