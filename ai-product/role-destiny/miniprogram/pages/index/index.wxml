<!--首页 · 命格宫殿-->
<view class="home">

  <!-- ══ 英雄区 ══ -->
  <view class="hero" style="padding-top: {{statusBarH + 24}}px;">

    <!-- 云雾与乱红 -->
    <view class="deco cloud-a"></view>
    <view class="deco cloud-b"></view>
    <view class="deco petal-a a-drift">🌸</view>
    <view class="deco petal-b a-drift" style="animation-delay: 1.6s;">🌸</view>

    <!-- 品牌 -->
    <view class="brand">
      <view class="brand-seal">👑</view>
      <view class="brand-name song">角色测算</view>
      <view class="brand-sub">八道题 · 测出你的宫闱命格</view>
    </view>

    <!-- 月门 -->
    <view class="gate a-bloom">
      <view class="gate-halo"></view>
      <view class="gate-ring"></view>
      <view class="gate-spark s1">✦</view>
      <view class="gate-spark s2">✦</view>

      <view
        class="gate-emblem {{item.cls}}"
        wx:for="{{gateEmblems}}"
        wx:key="code"
      >
        <view
          class="gem-circle a-drift"
          style="background: {{item.style.grad}}; animation-delay: {{item.delay}}s;"
        >
          <text class="gem-emoji">{{item.style.emblem}}</text>
        </view>
      </view>
    </view>

    <!-- CTA -->
    <view class="cta a-rise" style="animation-delay: 0.16s;">
      <view class="btn-main" bindtap="startTest">✨ 开始测算 ✨</view>
      <view class="cta-note" wx:if="{{firstTest}}">免费测完 · ¥{{firstTest.priceYuan}} 解锁完整命格</view>
    </view>

    <!-- 播报条 -->
    <view class="ticker a-rise" style="animation-delay: 0.28s;">
      <text class="ticker-mark">✦</text>
      <text class="ticker-text a-fade">{{tickerText}}</text>
    </view>
  </view>

  <!-- ══ 本期限定 ══ -->
  <view class="section">
    <view class="section-head">
      <view class="section-title song">本期 · 宫闱限定</view>
      <view class="section-link" bindtap="goTestList">全部测算 ›</view>
    </view>
    <view class="gold-rule"></view>

    <!-- 骨架 -->
    <view class="feature-card skeleton-block" wx:if="{{loading}}" style="height: 420rpx;"></view>

    <!-- 限定卡（只展示排序第一的主打主题） -->
    <view class="feature-card a-rise" wx:if="{{firstTest}}" bindtap="goTest" data-id="{{firstTest.id}}">
      <view class="fc-cover">
        <view class="fc-glow glow-a"></view>
        <view class="fc-glow glow-b"></view>
        <text class="fc-emblem">🏮</text>
        <view class="fc-flag">限 定</view>
        <view class="fc-lantern">✦</view>
      </view>
      <view class="fc-body">
        <view class="fc-title song">{{firstTest.title}}</view>
        <view class="fc-desc">{{firstTest.description}}</view>
        <view class="fc-meta">
          <view class="jade-tag">{{firstTest.question_count || 8}} 题 · 约 4 分钟</view>
          <view class="fc-price">¥{{firstTest.priceYuan}}</view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view class="empty-state" wx:if="{{!loading && testList.length === 0}}">
      <image src="/images/empty.png" mode="aspectFit"></image>
      <view class="empty-title">宫人们正在筹备测算</view>
      <view class="empty-hint">稍后再来吧</view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>