<!--历史记录页 · 命格卷宗-->
<view class="history-page">

  <!-- 页首 -->
  <view class="page-head a-rise">
    <view class="ph-title song">命格卷宗</view>
    <view class="ph-sub">每一世的选择，都在这里留痕</view>
    <view class="gold-rule"></view>
  </view>

  <!-- 卷宗列表 -->
  <view class="history-list" wx:if="{{!loading && historyList.length > 0}}">
    <view
      class="history-item a-rise"
      style="animation-delay: {{index * 0.06}}s;"
      wx:for="{{historyList}}"
      wx:key="id"
      bindtap="goResult"
      data-id="{{item.id}}"
    >
      <view class="item-emblem" style="background: {{item.roleStyle.grad}};">
        <text class="item-emoji">{{item.roleStyle.emblem}}</text>
      </view>
      <view class="item-main">
        <view class="item-row">
          <view class="item-name song">{{item.role_name || '未名命格'}}</view>
          <view class="item-badge {{item.is_paid ? 'paid' : 'locked'}}">
            {{item.is_paid ? '已解锁' : '待解锁'}}
          </view>
        </view>
        <view class="item-meta">{{item.created_at}} · 契合度 {{item.match_score}}%</view>
      </view>
      <view class="item-arrow">›</view>
    </view>
  </view>

  <!-- 骨架 -->
  <view class="sk-list" wx:if="{{loading}}">
    <view class="skeleton-block" style="height: 140rpx;"></view>
    <view class="skeleton-block" style="height: 140rpx; margin-top: 22rpx;"></view>
    <view class="skeleton-block" style="height: 140rpx; margin-top: 22rpx;"></view>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:if="{{!loading && empty}}">
    <image src="/images/empty_history.png" mode="aspectFit"></image>
    <view class="empty-title">卷宗尚无记载</view>
    <view class="empty-hint">入宫测一次，写下你的第一世</view>
    <view class="btn-main empty-cta" bindtap="goTest">✨ 去测算</view>
  </view>

  <view class="safe-bottom"></view>
</view>