<!--个人中心页-->
<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-info">
      <image
        class="avatar"
        src="{{userInfo.avatar || '/images/default_avatar.png'}}"
        mode="aspectFill"
      ></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
        <text class="user-id">ID: {{userInfo.openid ? userInfo.openid.slice(0, 8) : '----'}}...</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goHistory">
      <text class="stat-value">{{stats.testCount}}</text>
      <text class="stat-label">测试记录</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{stats.paidCount}}</text>
      <text class="stat-label">已解锁</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goHistory">
      <view class="menu-left">
        <text class="menu-icon">📋</text>
        <text class="menu-text">测试记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item">
      <view class="menu-left">
        <text class="menu-icon">📱</text>
        <text class="menu-text">绑定手机</text>
      </view>
      <button class="btn-bind-phone" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        {{userInfo.phone ? '已绑定' : '去绑定'}}
      </button>
    </view>

    <view class="menu-item" bindtap="goAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>v1.0.0</text>
  </view>
</view>
