<!--个人中心页 · 我的命牌-->
<view class="profile-page">

  <!-- 命牌 -->
  <view class="id-panel">
    <view class="panel-glow a"></view>
    <view class="panel-glow b"></view>

    <view class="id-row a-rise">
      <view class="avatar-ring">
        <image
          wx:if="{{userInfo && userInfo.avatar}}"
          class="avatar-img"
          src="{{userInfo.avatar}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="avatar-fallback">🙂</view>
      </view>
      <view class="id-info">
        <view class="nickname song">{{userInfo && userInfo.nickname ? userInfo.nickname : '未赐名的小主'}}</view>
        <view class="id-code">宫籍 {{userInfo && userInfo.openid ? userInfo.openid.slice(0, 8) : '————'}}…</view>
      </view>
    </view>

    <!-- 心绪统计 -->
    <view class="stats a-rise" style="animation-delay: 0.12s;">
      <view class="stat-cell" bindtap="goHistory">
        <view class="stat-num song">{{stats.testCount}}</view>
        <view class="stat-label">测算次数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell" bindtap="goHistory">
        <view class="stat-num song">{{stats.paidCount}}</view>
        <view class="stat-label">已解锁命格</view>
      </view>
    </view>
  </view>

  <!-- 宫务菜单 -->
  <view class="menu a-rise" style="animation-delay: 0.24s;">
    <view class="menu-item" bindtap="goHistory">
      <view class="menu-icon">📜</view>
      <view class="menu-text">测算记录</view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="gold-rule menu-rule"></view>

    <view class="menu-item">
      <view class="menu-icon">📱</view>
      <view class="menu-text">绑定手机</view>
      <button class="menu-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        {{userInfo && userInfo.phone ? '已绑定' : '去绑定'}}
      </button>
    </view>

    <view class="gold-rule menu-rule"></view>

    <view class="menu-item" bindtap="goAbout">
      <view class="menu-icon">🏮</view>
      <view class="menu-text">关于测算</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="version">角色测算 v1.0.0</view>
  <view class="safe-bottom"></view>
</view>