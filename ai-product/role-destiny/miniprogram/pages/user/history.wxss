/* 历史记录页 · 命格卷宗 */

.history-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF8F3 260rpx);
  padding: 40rpx 32rpx;
}

/* 页首 */
.page-head {
  margin-bottom: 36rpx;
}

.ph-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--c-ink);
}

.ph-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--c-ash);
}

.page-head .gold-rule {
  margin-top: 26rpx;
}

/* 卷宗条目 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--r-card);
  padding: 28rpx 30rpx;
  box-shadow: var(--sh-card);
  transition: transform 0.15s ease;
}

.history-item:active {
  transform: scale(0.98);
}

.item-emblem {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 16rpx rgba(63, 47, 54, 0.12);
}

.item-emoji {
  font-size: 44rpx;
}

.item-main {
  flex: 1;
  margin-left: 26rpx;
  min-width: 0;
}

.item-row {
  display: flex;
  align-items: center;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--c-ink);
}

.item-badge {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.item-badge.paid {
  color: #8A6420;
  background: linear-gradient(135deg, #F2DDA6 0%, #E8C878 100%);
}

.item-badge.locked {
  color: var(--c-mist);
  background: #F4F1F2;
}

.item-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--c-mist);
}

.item-arrow {
  font-size: 34rpx;
  color: var(--c-mist);
  margin-left: 12rpx;
}

/* 骨架 */
.sk-list {
  display: flex;
  flex-direction: column;
}

/* 空态 CTA */
.empty-cta {
  width: 320rpx;
  height: 88rpx;
  font-size: 28rpx;
}