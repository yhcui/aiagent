/* 个人中心页 · 我的命牌 */

.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE9F0 0%, #FFF8F3 500rpx);
  padding: 0 32rpx;
}

/* ── 命牌 ── */
.id-panel {
  position: relative;
  margin-top: 24rpx;
  border-radius: var(--r-card);
  padding: 40rpx 36rpx 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FFB7CC 0%, #FF8EB3 45%, #F2A08A 100%);
  box-shadow: 0 18rpx 44rpx rgba(255, 107, 157, 0.34);
}

.panel-glow {
  position: absolute;
  border-radius: 50%;
}

.panel-glow.a {
  width: 360rpx;
  height: 360rpx;
  right: -140rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0) 68%);
}

.panel-glow.b {
  width: 300rpx;
  height: 300rpx;
  left: -120rpx;
  bottom: -140rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 68%);
}

.id-row {
  position: relative;
  display: flex;
  align-items: center;
}

.avatar-ring {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border: 5rpx solid #F5E9CE;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.16);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 64rpx;
}

.id-info {
  margin-left: 30rpx;
  flex: 1;
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

.id-code {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* 统计 */
.stats {
  position: relative;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.26);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 20rpx;
  padding: 24rpx 0;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.45);
}

/* ── 宫务菜单 ── */
.menu {
  margin-top: 28rpx;
  background: #fff;
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 34rpx 32rpx;
  transition: background 0.12s ease;
}

.menu-item:active {
  background: #FBF4F6;
}

.menu-icon {
  font-size: 34rpx;
  width: 56rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  margin-left: 10rpx;
  font-size: 28rpx;
  color: var(--c-ink);
}

.menu-arrow {
  font-size: 34rpx;
  color: var(--c-mist);
}

.menu-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--c-rouge-deep);
  background: var(--c-blush);
  border: 1rpx solid #FFD3DF;
}

.menu-btn::after {
  border: none;
}

.menu-rule {
  margin: 0 32rpx;
  opacity: 0.6;
}

/* 版本 */
.version {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--c-mist);
}