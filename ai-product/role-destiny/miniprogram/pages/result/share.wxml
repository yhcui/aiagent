<!--分享结果页 - 海报预览-->
<view class="share-page">
  <!-- 海报预览 -->
  <view class="poster-preview" wx:if="{{!loading && posterUrl}}">
    <image
      class="poster-image"
      src="{{posterUrl}}"
      mode="aspectFit"
      bindtap="previewPoster"
    ></image>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>海报生成中...</text>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar safe-area-bottom" wx:if="{{!loading}}">
    <button class="btn-save" bindtap="savePoster">
      保存图片
    </button>
    <button class="btn-share" open-type="share">
      分享给好友
    </button>
  </view>

  <!-- 关闭按钮 -->
  <view class="close-btn" bindtap="close">×</view>
</view>
