<!--结果页 · 命格揭晓-->
<view class="result-page" wx:if="{{!loading && result}}">

  <!-- 英雄：命格徽记 -->
  <view class="hero" style="background: {{roleStyle.grad}}; padding-top: {{statusBarH}}px;">
    <view class="hero-deco deco-a"></view>
    <view class="hero-deco deco-b"></view>

    <!-- 返回 -->
    <view class="back-btn" style="top: {{statusBarH + 8}}px;" bindtap="goBack">
      <view class="back-chev">‹</view>
    </view>

    <view class="hero-body a-bloom">
      <view class="medallion" style="box-shadow: 0 20rpx 50rpx rgba({{roleStyle.coreRGB}}, 0.45), inset 0 0 0 12rpx rgba(255,255,255,0.35);">
        <text class="medallion-emoji">{{roleStyle.emblem}}</text>
      </view>
      <view class="rarity-seal {{raritySeal.cls}}">{{raritySeal.label}}</view>

      <view class="role-name song">{{result.role.name}}</view>
      <view class="role-desc">{{result.role.description}}</view>

      <view class="match-block">
        <view class="match-num-wrap">
          <text class="match-num song">{{matchInt}}</text>
          <text class="match-unit">%</text>
        </view>
        <view class="match-label">与你的命格契合度</view>
        <view class="ribbon-track">
          <view class="ribbon-fill" style="width: {{matchInt}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 珠帘角 -->
  <view class="hero-fringe">
    <view class="fringe-bead" wx:for="{{12}}" wx:key="index"></view>
  </view>

  <!-- ══ 未解锁：封存的命格 ══ -->
  <block wx:if="{{!isPaid}}">
    <view class="sealed a-rise" style="animation-delay: 0.12s;">
      <!-- 被封印的模糊内容 -->
      <view class="sealed-blur">
        <view class="sb-line w60"></view>
        <view class="sb-line w90"></view>
        <view class="sb-line w75"></view>
        <view class="sb-head"></view>
        <view class="sb-line w85"></view>
        <view class="sb-line w55"></view>
        <view class="sb-head"></view>
        <view class="sb-line w70"></view>
        <view class="sb-line w92"></view>
        <view class="sb-line w50"></view>
      </view>

      <!-- 锁 -->
      <view class="sealed-lock">
        <view class="lock-icon">🔒</view>
        <view class="lock-title song">命格详解已封存</view>
        <view class="lock-desc">解锁后查看：性格画像 · 命运走向 · 天赋与暗影 · 命格箴言</view>
        <view class="btn-gold lock-btn" bindtap="unlockReport">
          🔓 解锁完整命格 · ¥{{priceYuan}}
        </view>
        <view class="lock-proof">已有 {{unlockCount}} 位小主解锁了自己的命格</view>
      </view>
    </view>

    <view class="retest-link a-rise" style="animation-delay: 0.24s;" bindtap="retest">换一世再测一次 ›</view>
  </block>

  <!-- ══ 已解锁：完整命格 ══ -->
  <block wx:if="{{isPaid && result.full_role}}">
    <view class="report">
      <!-- 判词 -->
      <view class="paper st-item" wx:if="{{result.full_role.detail_text}}">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">🏮</view>
          <view class="head-title">命 格 判 词</view>
        </view>
        <view class="verdict song">{{result.full_role.detail_text}}</view>
      </view>

      <!-- 性格画像 -->
      <view class="paper st-item">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">🌸</view>
          <view class="head-title">性 格 画 像</view>
        </view>
        <view class="paper-body">{{result.full_role.personality}}</view>
      </view>

      <!-- 命运走向 -->
      <view class="paper st-item">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">🔮</view>
          <view class="head-title">命 运 走 向</view>
        </view>
        <view class="paper-body">{{result.full_role.destiny}}</view>
      </view>

      <!-- 天赋与暗影 -->
      <view class="paper st-item">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">✦</view>
          <view class="head-title">天 赋 加 身</view>
        </view>
        <view class="chip-row">
          <view class="chip chip-good" wx:for="{{result.full_role.advantages}}" wx:key="index">{{item}}</view>
        </view>

        <view class="gold-rule dual-rule"></view>

        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">☁️</view>
          <view class="head-title">暗 影 须 知</view>
        </view>
        <view class="chip-row">
          <view class="chip chip-dark" wx:for="{{result.full_role.weaknesses}}" wx:key="index">{{item}}</view>
        </view>
      </view>

      <!-- 命格箴言 -->
      <view class="paper paper-suggest st-item">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem">✨</view>
          <view class="head-title">命 格 箴 言</view>
        </view>
        <view class="paper-body">{{result.full_role.suggestion}}</view>
      </view>

      <!-- 幸运之物 -->
      <view class="paper st-item">
        <view class="paper-edge"></view>
        <view class="card-head">
          <view class="head-emblem" style="background: {{roleStyle.tint}};">⭐</view>
          <view class="head-title">幸 运 之 物</view>
        </view>
        <view class="lucky-row">
          <view class="lucky-cell">
            <view class="lucky-value song">{{result.full_role.lucky_number}}</view>
            <view class="lucky-label">幸运数字</view>
          </view>
          <view class="lucky-cell">
            <view class="lucky-value song">{{result.full_role.lucky_color}}</view>
            <view class="lucky-label">幸运颜色</view>
          </view>
          <view class="lucky-cell">
            <view class="lucky-value song lucky-motto">{{result.full_role.motto}}</view>
            <view class="lucky-label">座 右 铭</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="cta-bar safe-bottom">
      <view class="btn-ghost cta-retest" bindtap="retest">重新测算</view>
      <view class="btn-main cta-poster" bindtap="shareResult">✨ 生成专属海报</view>
    </view>
  </block>

  <view class="safe-bottom-space"></view>
</view>

<!-- 加载骨架 -->
<view class="loading-page" wx:if="{{loading}}">
  <view class="skeleton-block" style="height: 720rpx;"></view>
  <view class="skeleton-block" style="height: 300rpx; margin-top: 24rpx;"></view>
</view>