/* 分享海报页 · 命格御画 */

.share-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background:
    radial-gradient(circle at 20% 8%, rgba(255, 107, 157, 0.14) 0%, rgba(255, 107, 157, 0) 55%),
    radial-gradient(circle at 85% 90%, rgba(201, 162, 75, 0.12) 0%, rgba(201, 162, 75, 0) 55%),
    #2E2430;
}

/* 顶栏 */
.share-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 28rpx;
  box-sizing: border-box;
}

.close-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.close-chev {
  font-size: 40rpx;
  line-height: 1;
  color: #fff;
  margin-top: -4rpx;
}

.share-title {
  font-size: 32rpx;
  letter-spacing: 8rpx;
  color: #F5E9CE;
}

.head-holder {
  width: 64rpx;
}

/* 海报舞台 */
.poster-stage {
  margin-top: 10rpx;
  display: flex;
  justify-content: center;
}

.poster-canvas {
  width: 560rpx;
  height: 1000rpx;
  border-radius: 32rpx;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.45);
}

/* 绘制中 */
.poster-loading {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
}

.loading-ring {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.16);
  border-top-color: #FFB7CC;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.pl-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.62);
  text-align: center;
}

.retry-btn {
  margin-top: 36rpx;
  width: 260rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.4);
  color: #fff;
}

/* 操作栏 */
.share-bar {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  gap: 24rpx;
  padding: 30rpx 32rpx 34rpx;
}

.btn-share-ghost {
  flex-shrink: 0;
  width: 240rpx;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #F5E9CE;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  margin: 0;
}

.btn-share-ghost::after {
  border: none;
}

.btn-save {
  flex: 1;
}