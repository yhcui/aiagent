/* 结果页 · 命格揭晓 */

.result-page {
  min-height: 100vh;
  background: var(--c-cloud);
}

/* ── 英雄：命格徽记 ── */
.hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32rpx 56rpx;
  overflow: hidden;
  border-radius: 0 0 48rpx 48rpx;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.deco-a {
  width: 460rpx;
  height: 460rpx;
  right: -180rpx;
  top: -160rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0) 70%);
}

.deco-b {
  width: 380rpx;
  height: 380rpx;
  left: -160rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 70%);
}

.back-btn {
  position: absolute;
  left: 28rpx;
  z-index: 5;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.1);
}

.back-chev {
  font-size: 40rpx;
  line-height: 1;
  color: var(--c-ink);
  margin-top: -4rpx;
}

.hero-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* 徽记圆盘 */
.medallion {
  margin-top: 46rpx;
  width: 264rpx;
  height: 264rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
}

.medallion-emoji {
  font-size: 120rpx;
  filter: drop-shadow(0 8rpx 14rpx rgba(0, 0, 0, 0.15));
}

/* 稀有度玉档 */
.rarity-seal {
  margin-top: 22rpx;
  padding: 6rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.16);
}

.seal-gold {
  background: linear-gradient(135deg, #E8C878 0%, #C9A24B 60%, #A07B2C 100%);
}

.seal-plum {
  background: linear-gradient(135deg, #A988C9 0%, #7C5FA3 100%);
}

.seal-teal {
  background: linear-gradient(135deg, #6FA9C0 0%, #3F86A3 100%);
}

/* 名号 */
.role-name {
  margin-top: 26rpx;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--c-ink);
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.55);
}

.role-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: rgba(59, 47, 54, 0.68);
  text-align: center;
  max-width: 560rpx;
  line-height: 1.7;
}

/* 契合度 */
.match-block {
  margin-top: 36rpx;
  width: 100%;
  max-width: 480rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 28rpx 34rpx 30rpx;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.08);
}

.match-num-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.match-num {
  font-size: 76rpx;
  font-weight: 700;
  color: var(--c-ink);
}

.match-unit {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 6rpx;
  color: var(--c-ash);
}

.match-label {
  margin-top: 4rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: var(--c-mist);
}

.ribbon-track {
  margin-top: 20rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(59, 47, 54, 0.12);
  overflow: hidden;
}

.ribbon-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FF9DBB 0%, #FF6B9D 55%, #FF8E53 100%);
  animation: fillGrow 0.9s cubic-bezier(0.22, 0.9, 0.35, 1) both;
}

@keyframes fillGrow {
  from { width: 0; }
}

/* 珠帘角 */
.hero-fringe {
  display: flex;
  justify-content: center;
  position: relative;
  z-index: 9;
  gap: 38rpx;
}

.fringe-bead {
  margin-top: -4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #E8C878 0%, #C9A24B 100%);
  box-shadow: 0 6rpx 10rpx rgba(201, 162, 75, 0.45);
}

.fringe-bead::after {
  content: "";
  display: block;
  width: 2rpx;
  height: 26rpx;
  margin: 14rpx auto 0;
  background: linear-gradient(180deg, rgba(201, 162, 75, 0.8), rgba(201, 162, 75, 0));
}

/* ── 封存的命格 ── */
.sealed {
  position: relative;
  margin: 48rpx 32rpx 0;
  background: #fff;
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  overflow: hidden;
  min-height: 560rpx;
  display: flex;
  align-items: center;
}

.sealed-blur {
  position: absolute;
  inset: 0;
  padding: 40rpx 36rpx;
  filter: blur(12rpx);
  opacity: 0.55;
  pointer-events: none;
}

.sb-line {
  height: 24rpx;
  border-radius: 12rpx;
  background: #EADDE2;
  margin-bottom: 22rpx;
}

.sb-head {
  height: 40rpx;
  width: 220rpx;
  border-radius: 10rpx;
  background: #F0C9D4;
  margin: 30rpx 0 22rpx;
}

.w60 { width: 60%; }
.w90 { width: 90%; }
.w75 { width: 75%; }
.w85 { width: 85%; }
.w55 { width: 55%; }
.w70 { width: 70%; }
.w92 { width: 92%; }
.w50 { width: 50%; }

.sealed-lock {
  position: relative;
  z-index: 2;
  margin: 40rpx auto;
  padding: 48rpx 36rpx 40rpx;
  max-width: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid #F3E4E9;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(63, 47, 54, 0.14);
}

.lock-icon {
  font-size: 60rpx;
}

.lock-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--c-ink);
}

.lock-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: var(--c-ash);
  text-align: center;
  line-height: 1.7;
}

.lock-btn {
  margin-top: 32rpx;
  width: 100%;
}

.lock-proof {
  margin-top: 20rpx;
  font-size: 21rpx;
  color: var(--c-mist);
  letter-spacing: 1rpx;
}

.retest-link {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-mist);
  letter-spacing: 2rpx;
}

/* ── 完整命格报告 ── */
.report {
  margin: -24rpx 32rpx 0;
  position: relative;
  z-index: 10;
}

.paper {
  position: relative;
  background: #fff;
  border-radius: var(--r-card);
  padding: 36rpx 32rpx 32rpx;
  box-shadow: var(--sh-card);
  margin-bottom: 28rpx;
}

.paper:first-child {
  margin-top: 48rpx;
}

.paper-edge {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(90deg, rgba(255, 107, 157, 0) 0%, rgba(255, 107, 157, 0.75) 50%, rgba(255, 107, 157, 0) 100%);
}

.paper-body {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--c-ash);
}

/* 判词（卷轴引言） */
.verdict {
  font-size: 30rpx;
  line-height: 2;
  color: var(--c-ink);
  background: linear-gradient(135deg, #FFF6F2 0%, #FFFDF8 100%);
  border: 1rpx solid #F3E4D7;
  border-radius: 16rpx;
  padding: 28rpx;
}

.dual-rule {
  margin: 30rpx 0 26rpx;
}

/* 天赋/暗影屑 */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.chip-good {
  background: var(--c-blush);
  color: var(--c-rouge-deep);
  border: 1rpx solid #FFD3DF;
}

.chip-dark {
  background: #F4F1F2;
  color: var(--c-ash);
  border: 1rpx solid #E8E1E4;
}

/* 箴言 */
.paper-suggest {
  background: linear-gradient(160deg, #FFF7EE 0%, #FFFDF8 55%, #FFFFFF 100%);
  border: 1rpx solid #F3E6CD;
}

/* 幸运之物 */
.lucky-row {
  display: flex;
  align-items: stretch;
}

.lucky-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 8rpx;
}

.lucky-cell + .lucky-cell {
  border-left: 1rpx solid #F3E9EC;
}

.lucky-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-ink);
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.5;
}

.lucky-motto {
  font-size: 26rpx;
}

.lucky-label {
  margin-top: 12rpx;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--c-mist);
}

/* ── 底部操作 ── */
.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx 28rpx;
  background: linear-gradient(180deg, rgba(255, 248, 243, 0) 0%, rgba(255, 248, 243, 0.96) 30%, #FFF8F3 100%);
}

.cta-retest {
  flex-shrink: 0;
  width: 220rpx;
  height: 96rpx;
}

.cta-poster {
  flex: 1;
}

.safe-bottom-space {
  height: 200rpx;
}

/* 加载 */
.loading-page {
  padding: 32rpx;
}