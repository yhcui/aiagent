/* 结果详情页样式 */

.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF 50%, #F5F5F5 100%);
  padding-bottom: 140rpx;
}

/* 角色卡片 */
.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(180deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.role-header {
  margin-bottom: 20rpx;
}

.role-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.role-image {
  width: 300rpx;
  height: 300rpx;
  background: white;
  border-radius: 50%;
  padding: 10rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
}

.role-image image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.role-name {
  margin-top: 30rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.role-code {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 4rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.role-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  text-align: center;
  max-width: 600rpx;
  line-height: 1.6;
}

/* 匹配度 */
.match-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.score-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid rgba(255, 255, 255, 0.5);
}

.score-inner {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: white;
}

.score-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.score-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 报告区域 */
.report-section {
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin: 30rpx 0 20rpx;
}

.report-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.report-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 分析卡片 */
.analysis-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.analysis-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.analysis-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: white;
}

.advantage .analysis-icon {
  background: #52C41A;
}

.weakness .analysis-icon {
  background: #FAAD14;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.analysis-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.analysis-list text {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

/* 幸运属性 */
.lucky-card {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.lucky-item {
  flex: 1;
  min-width: 180rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.lucky-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.lucky-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B6B;
}

.lucky-value.motto {
  font-size: 24rpx;
  color: #666;
}

/* 解锁区域 */
.unlock-section {
  padding: 30rpx;
  margin-top: 30rpx;
}

.unlock-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.unlock-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.unlock-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.btn-unlock {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  padding: 24rpx 60rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  background: white;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.bottom-bar button {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  background: #f5f5f5;
  color: #666;
}

.btn-share, .btn-poster {
  background: #FFF5F5;
  color: #FF6B6B;
}

.btn-retest {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: white;
}

.btn-icon {
  font-size: 32rpx;
}

/* 加载状态 */
.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: #999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #FF6B6B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
