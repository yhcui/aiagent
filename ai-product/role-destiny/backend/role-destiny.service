[Unit]
Description=Role Destiny Mini Program Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/path/to/role-destiny/backend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 /path/to/role-destiny/backend/app/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
