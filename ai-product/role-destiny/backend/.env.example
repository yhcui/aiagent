# 应用配置
APP_NAME=角色测算小程序
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./data/role_destiny.db

# 微信小程序配置
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your-app-secret

# 微信支付配置
WECHAT_MCH_ID=1234567890
WECHAT_API_KEY=your-payment-api-key
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/notify

# 支付模式开关：mock=模拟支付（不调微信，直接解锁）；real=真实微信支付JSAPI
# 切 real 前需满足：商户号已申请并绑定AppID + APIv2密钥已设置 + 服务器有公网HTTPS域名
PAYMENT_MODE=mock

# 解锁方式开关：pay=付费解锁（配合PAYMENT_MODE）| ad=激励视频广告解锁（个人主体变现）
# ad 模式需在小程序后台开通流量主，创建「激励式视频广告」位后把广告位ID填到下面
UNLOCK_MODE=pay
REWARDED_AD_UNIT_ID=adunit-xxxxxxxxxxxxxxxx

# 缓存配置
CACHE_MAX_SIZE=1000
CACHE_TTL=300

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件存储
STATIC_DIR=./static
DATA_DIR=./data
