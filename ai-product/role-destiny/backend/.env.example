# 应用配置
APP_NAME=角色测算小程序
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./data/role_destiny.db

# 微信小程序配置
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your-app-secret

# 微信支付配置
WECHAT_MCH_ID=1234567890
WECHAT_API_KEY=your-payment-api-key
WECHAT_NOTIFY_URL=https://yourdomain.com/api/payment/notify

# 缓存配置
CACHE_MAX_SIZE=1000
CACHE_TTL=300

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件存储
STATIC_DIR=./static
DATA_DIR=./data
